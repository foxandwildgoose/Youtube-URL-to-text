# Server only. Never use a VITE_ prefix for either secret.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# A random personal access code with at least 24 characters. Keep its value out
# of source control; enter it in the app only for the current browser session.
TRANSCRIPTION_ACCESS_TOKEN=

# Visual slide extraction. Blank dedicated token falls back to transcription.
SLIDES_ACCESS_TOKEN=
SLIDES_STANDARD_MODEL=gpt-6.1-sol
SLIDES_ECONOMY_MODEL=gpt-6-luna
SLIDES_STANDARD_REASONING=low
SLIDES_ECONOMY_REASONING=none
SLIDES_DETAIL=auto
SLIDES_MAX_OUTPUT_TOKENS=4096
SLIDES_TIMEOUT_MS=45000
# Optional Standard pricing overrides (USD per 1M). Leave unset unless updating
# verified prices. Overrides are marked operator-supplied in the UI.
# SLIDES_INPUT_USD_PER_M=2
# SLIDES_OUTPUT_USD_PER_M=10
